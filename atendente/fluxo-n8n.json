            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transferir?": {
      "main": [
        [
          {
            "node": "Avisar recepção (Chatwoot)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Enviar WhatsApp (Graph API)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar WhatsApp (Graph API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisar recepção (Chatwoot)": {
      "main": [
        [
          {
            "node": "Responder ao webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar WhatsApp (Graph API)": {
      "main": [
        [
          {
            "node": "Responder ao webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
